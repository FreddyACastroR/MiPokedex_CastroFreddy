<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- ===== Guidelines ===== -->

    <!-- Centro de la pokébola de fondo -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_h_pokeball"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_v_pokeball"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.745" />

    <!-- Área de la imagen del Pokémon (se encima sobre la tarjeta) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_h_pokemon_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_h_pokemon_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.335" />

    <!-- Inicio de la tarjeta blanca -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_h_card_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.29" />

    <!-- Separación etiqueta | valor de Altura y Peso -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_v_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.27" />

    <!-- Inicio de la columna de Habilidad -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_v_ability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.555" />

    <!-- ===== Encabezado ===== -->

    <!-- Centrada sobre el cruce de sus dos guidelines; sobresale de la pantalla -->
    <ImageView
        android:id="@+id/iv_pokeball"
        android:layout_width="@dimen/pokeball_size"
        android:layout_height="@dimen/pokeball_size"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_pokeball"
        app:layout_constraintBottom_toBottomOf="@id/gl_h_pokeball"
        app:layout_constraintEnd_toEndOf="@id/gl_v_pokeball"
        app:layout_constraintStart_toStartOf="@id/gl_v_pokeball"
        app:layout_constraintTop_toTopOf="@id/gl_h_pokeball" />

    <TextView
        android:id="@+id/tv_name"
        style="@style/PokedexText.Name"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:text="@string/pokemon_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_number"
        style="@style/PokedexText.Number"
        android:text="@string/pokemon_number"
        app:layout_constraintEnd_toEndOf="@id/tv_name"
        app:layout_constraintTop_toBottomOf="@id/tv_name" />

    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="@dimen/favorite_size"
        android:layout_height="@dimen/favorite_size"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginEnd="@dimen/margin_small"
        android:contentDescription="@string/cd_favorite"
        android:src="@drawable/ic_star"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== Tarjeta ===== -->

    <View
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gl_h_card_top" />

    <!-- Alto definido por las guidelines, ancho calculado con el ratio 1:1 -->
    <ImageView
        android:id="@+id/iv_pokemon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_pokemon_image"
        android:scaleType="fitCenter"
        android:src="@drawable/pikachu"
        app:layout_constraintBottom_toBottomOf="@id/gl_h_pokemon_bottom"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gl_h_pokemon_top" />

    <TextView
        android:id="@+id/tv_type"
        style="@style/PokedexText.Type"
        android:layout_marginTop="@dimen/margin_type_top"
        android:text="@string/pokemon_type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/card" />

    <!-- Altura / Peso: etiquetas alineadas al final y valores al inicio de gl_v_stats -->
    <TextView
        android:id="@+id/tv_height_label"
        style="@style/PokedexText.StatLabel"
        android:layout_marginTop="@dimen/margin_medium"
        android:layout_marginEnd="@dimen/margin_stats_gap"
        android:text="@string/label_height"
        app:layout_constraintEnd_toStartOf="@id/gl_v_stats"
        app:layout_constraintTop_toBottomOf="@id/tv_type" />

    <TextView
        android:id="@+id/tv_height_value"
        style="@style/PokedexText.StatValue"
        android:layout_marginStart="@dimen/margin_stats_gap"
        android:text="@string/pokemon_height"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_height_label"
        app:layout_constraintStart_toEndOf="@id/gl_v_stats" />

    <TextView
        android:id="@+id/tv_weight_label"
        style="@style/PokedexText.StatLabel"
        android:layout_marginTop="@dimen/margin_stats_rows"
        android:layout_marginEnd="@dimen/margin_stats_gap"
        android:text="@string/label_weight"
        app:layout_constraintEnd_toStartOf="@id/gl_v_stats"
        app:layout_constraintTop_toBottomOf="@id/tv_height_label" />

    <TextView
        android:id="@+id/tv_weight_value"
        style="@style/PokedexText.StatValue"
        android:layout_marginStart="@dimen/margin_stats_gap"
        android:text="@string/pokemon_weight"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_weight_label"
        app:layout_constraintStart_toEndOf="@id/gl_v_stats" />

    <!-- Habilidad: cadena vertical "packed" centrada entre Altura y Peso -->
    <TextView
        android:id="@+id/tv_ability_label"
        style="@style/PokedexText.StatLabel"
        android:text="@string/label_ability"
        app:layout_constraintBottom_toTopOf="@id/tv_ability_value"
        app:layout_constraintStart_toStartOf="@id/gl_v_ability"
        app:layout_constraintTop_toTopOf="@id/tv_height_label"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_ability_value"
        style="@style/PokedexText.StatValue"
        android:layout_width="0dp"
        android:layout_marginEnd="@dimen/margin_medium"
        android:text="@string/pokemon_ability"
        app:layout_constraintBottom_toBottomOf="@id/tv_weight_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gl_v_ability"
        app:layout_constraintTop_toBottomOf="@id/tv_ability_label" />

    <!-- Ocupa el espacio libre entre las estadísticas y la navegación -->
    <TextView
        android:id="@+id/tv_description"
        style="@style/PokedexText.Description"
        android:layout_marginStart="@dimen/margin_description"
        android:layout_marginEnd="@dimen/margin_description"
        android:text="@string/pokemon_description"
        app:layout_constraintBottom_toTopOf="@id/iv_prev_pokemon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_weight_label"
        app:layout_constraintVertical_bias="0.25" />

    <!-- ===== Navegación: cadena horizontal "spread_inside" ===== -->

    <TextView
        android:id="@+id/tv_prev_pokemon"
        style="@style/PokedexText.Nav"
        android:layout_marginStart="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/prev_pokemon"
        app:drawableStartCompat="@drawable/ic_arrow_prev"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_next_pokemon"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_next_pokemon"
        style="@style/PokedexText.Nav"
        android:layout_marginEnd="@dimen/margin_small"
        android:layout_marginBottom="@dimen/margin_small"
        android:text="@string/next_pokemon"
        app:drawableEndCompat="@drawable/ic_arrow_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_prev_pokemon" />

    <ImageView
        android:id="@+id/iv_prev_pokemon"
        style="@style/PokedexNeighborImage"
        android:layout_marginBottom="@dimen/margin_small"
        android:contentDescription="@string/cd_prev_pokemon_image"
        android:src="@drawable/arbok"
        app:layout_constraintBottom_toTopOf="@id/tv_prev_pokemon"
        app:layout_constraintEnd_toEndOf="@id/tv_prev_pokemon"
        app:layout_constraintStart_toStartOf="@id/tv_prev_pokemon" />

    <ImageView
        android:id="@+id/iv_next_pokemon"
        style="@style/PokedexNeighborImage"
        android:layout_marginBottom="@dimen/margin_small"
        android:contentDescription="@string/cd_next_pokemon_image"
        android:src="@drawable/raichu"
        app:layout_constraintBottom_toTopOf="@id/tv_next_pokemon"
        app:layout_constraintEnd_toEndOf="@id/tv_next_pokemon"
        app:layout_constraintStart_toStartOf="@id/tv_next_pokemon" />

</androidx.constraintlayout.widget.ConstraintLayout>
