<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo amarillo; la franja blanca inferior continúa la tarjeta bajo la barra de navegación -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pokedex_yellow" />
        </shape>
    </item>
    <item
        android:height="@dimen/screen_bottom_strip"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
