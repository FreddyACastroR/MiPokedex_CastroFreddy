<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base de todos los textos de la pantalla -->
    <style name="PokedexText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PokedexText.Name">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_name</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PokedexText.Number">
        <item name="android:textColor">@color/text_number</item>
        <item name="android:textSize">@dimen/text_number</item>
    </style>

    <style name="PokedexText.Type">
        <item name="android:background">@drawable/bg_type_chip</item>
        <item name="android:paddingStart">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chip_padding_vertical</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_type</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PokedexText.StatLabel">
        <item name="android:textColor">@color/pokedex_red</item>
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PokedexText.StatValue">
        <item name="android:textSize">@dimen/text_stat</item>
    </style>

    <style name="PokedexText.Description">
        <item name="android:layout_width">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_description</item>
    </style>

    <style name="PokedexText.Nav">
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">@dimen/text_nav</item>
    </style>

    <!-- Imágenes del Pokémon anterior / siguiente -->
    <style name="PokedexNeighborImage">
        <item name="android:layout_width">@dimen/neighbor_image_size</item>
        <item name="android:layout_height">@dimen/neighbor_image_size</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
