<?xml version="1.0" encoding="utf-8"?><!--
   Qué se respalda en la nube en Android 11 y anteriores.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- La sesión no pasa a otro teléfono ni regresa al reinstalar la app: entraría sin
         pedir la contraseña -->
    <exclude domain="sharedpref" path="datosUsuario.xml" />
</full-backup-content>
